# Set these values as shell environment variables before running the scripts.
# Never commit real credentials.
HF_TOKEN=
DASHSCOPE_API_KEY=
XIAOAI_API_KEY=

# Training source, prepared dataset, initial model, and output directory.
TRAINING_ROOT=
DATA_PATH=
CKPT_PATH=
SAVE_PATH=
